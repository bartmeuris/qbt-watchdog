# Copy to `.env` next to your config file and fill in real values.
# Real `.env` files are git- and Docker-ignored; never commit secrets.
# See docs/configuration.md for substitution and quoting rules.
QBT_PASSWORD=change-me
# Alternative qBittorrent auth (mutually exclusive with username/password):
# QBT_API_KEY=replace-me
# QBT_USERNAME=admin
# Optional Sonarr/Radarr recovery credentials:
# SONARR_API_KEY=replace-me
# RADARR_API_KEY=replace-me
