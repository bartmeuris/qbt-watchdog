# Copy to `.env` NEXT TO YOUR CONFIG FILE (not the working directory) and fill
# in real values. Real `.env` files are git- and Docker-ignored. This example is
# committed, but excluded from Docker build context by `.dockerignore`; it still
# must never contain a real secret.
#
# Values here are only read when the configuration file references them by
# name, e.g. `qbt_password: '${QBT_PASSWORD}'`. Nothing is exported into the
# process environment, and nothing is expanded inside a value: `$NAME`, `$$`,
# `${OTHER}`, backticks and `$(...)` stay literal. A variable that is already
# set in the process environment always wins over the value here, including
# when it is set to an empty string.
#
# Syntax: one NAME=value per line, optional `export` prefix, spaces around `=`,
# CRLF, blank lines, comments, and single or double quotes. Duplicate names use
# the last value. Single quotes are fully literal. Double quotes decode only \n,
# \r, \t, \\, \" and \$. Unquoted `#` begins a comment only at the start of the
# value or after whitespace. Other escapes, multiline quotes, trailing tokens,
# NUL bytes, invalid UTF-8, and files over 1 MiB reject the configuration.

# qBittorrent credentials — use EITHER the API key OR username/password.
QBT_API_KEY=replace-me
# QBT_USERNAME=replace-me
# QBT_PASSWORD='replace-me # quoted values keep # and $ literal'

# Web UI credentials (both or neither).
# WEB_USERNAME=replace-me
# WEB_PASSWORD=replace-me

# Paths are ordinary strings too, so secret files can be pointed at from here.
# QBT_PASSWORD_FILE=/run/secrets/qbt_password
# TLS_CA_FILE=/etc/ssl/certs/qbt-ca.pem

# Optional Sonarr/Radarr recovery credentials. These placeholders do nothing
# unless config.yaml explicitly references ${SONARR_API_KEY} or ${RADARR_API_KEY}.
SONARR_API_KEY=replace-me
RADARR_API_KEY=replace-me
